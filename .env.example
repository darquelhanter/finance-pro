# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE_SERVICE_ACCOUNT: Required to verify Firebase ID tokens on the
# /api/ia/* and /api/schema-sql routes when NOT running on Google Cloud
# infrastructure (Vercel, for example, has no Application Default Credentials).
# Get it from the Firebase console: Project Settings > Service Accounts >
# Generate new private key. Paste the whole JSON file content as a single line.
# Not needed on Cloud Run/Cloud Functions, where this is obtained automatically.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...", ...}'
